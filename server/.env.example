# ───────────────────────────────────────────────────
# FitBid Server — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit the real .env file to source control.
# ───────────────────────────────────────────────────

PORT=5001
NODE_ENV=development

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/fitbid?retryWrites=true&w=majority

# JWT
JWT_SECRET=change_me_in_production_use_a_long_random_string
JWT_EXPIRE=7d

# Allowed frontend origins (comma-separated for multiple)
# Dev:        http://localhost:5000
# Production: https://your-app.vercel.app
CLIENT_URL=http://localhost:5000

# Cloudinary — https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_UPLOAD_PRESET=your_upload_preset
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=FitBid <noreply@fitbid.com>

# Stripe — https://stripe.com
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ───────────────────────────────────────────────────
# FitBid Client — Environment Variables
# Copy this file to .env.local for local dev.
# In Vercel, set these via the Project → Settings → Environment Variables UI.
# ───────────────────────────────────────────────────

# Full URL to the backend API (include /api at the end)
# Leave blank for local dev (Vite proxy handles it automatically)
# Production example: https://fitbid-server.onrender.com/api
VITE_API_URL=

# Full URL to the backend server for Socket.io (NO /api suffix)
# Leave blank for local dev.
# Production example: https://fitbid-server.onrender.com
VITE_SOCKET_URL=
